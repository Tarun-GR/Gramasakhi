# GramSakhi mobile — copy to .env and adjust for your environment.
# Never commit real secrets or production credentials.

# Backend API origin (no trailing slash). The client appends /api automatically.
#
# Android emulator → host machine:
#   EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
#
# Physical Android device on same Wi‑Fi → your PC LAN IP:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.100:8000
#
# Production deployment:
#   EXPO_PUBLIC_API_BASE_URL=https://api.your-gramsakhi-domain.example
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
