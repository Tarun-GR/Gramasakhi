DATABASE_URL=sqlite:///./gramsakhi.db

# Supabase Storage Integration (optional for local demos)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Secret / service_role required for private bucket create/upload
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rag-documents

# RAG Embedding Configuration
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIMENSIONS=1024
OLLAMA_API_URL=http://localhost:11434
# Phase 5 grounded generation (falls back to OLLAMA_API_URL if unset)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.2:3b
OLLAMA_MODEL=llama3.2:3b
OLLAMA_LLM_TEMPERATURE=0.1
OLLAMA_LLM_TIMEOUT_SECONDS=60
OLLAMA_LLM_NUM_PREDICT=512

# Hybrid RAG indexes (FAISS + BM25 + CrossEncoder)
HYBRID_INDEX_DIR=indexes
HYBRID_FAISS_WEIGHT=0.6
HYBRID_BM25_WEIGHT=0.4
HYBRID_CANDIDATE_K=20
HYBRID_TOP_K=5
HYBRID_RERANK_ENABLED=true
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Evidence sufficiency hard gate (Phase 4)
EVIDENCE_GATE_ENABLED=true
EVIDENCE_RELEVANCE_THRESHOLD=0.65
EVIDENCE_COVERAGE_THRESHOLD=0.6
EVIDENCE_AGREEMENT_THRESHOLD=0.7
EVIDENCE_AGREEMENT_VARIANCE_MAX=0.08
EVIDENCE_MIN_QUERY_TERMS=2
EVIDENCE_DOC_FLOOR=0.5
QUERY_EMBED_CACHE_SIZE=256

# Phase 6 — conversation + query rewriting
CONVERSATION_HISTORY_LIMIT=6
QUERY_REWRITE_USE_OLLAMA=false
QUERY_REWRITE_TIMEOUT_SECONDS=15

# Live government retrieval fallback
LIVE_GOV_FALLBACK_ENABLED=true
LIVE_GOV_MAX_SOURCES=4
LIVE_GOV_MAX_CANDIDATES=8
LIVE_GOV_MAX_PDFS=2
LIVE_GOV_MAX_PDF_SIZE_MB=10
LIVE_GOV_TIMEOUT_SECONDS=25
LIVE_GOV_OVERALL_TIMEOUT_SECONDS=240

# Voice / IVR placeholders (Phases 7–8)
STT_PROVIDER=mock
TTS_PROVIDER=mock
IVR_PROVIDER=mock

# Optional web ingest scheduler (disabled by default)
WEB_INGEST_SCHEDULER_ENABLED=false
WEB_INGEST_INTERVAL_HOURS=168
WEB_INGEST_SOURCE=central
WEB_INGEST_MAX_DOCS=3
