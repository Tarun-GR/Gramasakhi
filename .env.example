# Application
APP_ENV=development

# Backend (copy to backend/.env as needed)
DATABASE_URL=sqlite:///./gramsakhi.db
SECRET_KEY=change_me_in_production

# Supabase Storage (optional — required for remote document storage)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=rag-documents

# Ollama
OLLAMA_API_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=mxbai-embed-large
EMBEDDING_DIMENSIONS=1024

# Voice / IVR (Phase 7–8 — configuration placeholders)
STT_PROVIDER=mock
TTS_PROVIDER=mock
IVR_PROVIDER=mock
